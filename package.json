{
  "name": "andres-oliveira-advocacia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run optimize:assets && node scripts/prepare-public.mjs",
    "build": "npm run check && npm run check:seo && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "tsc --noEmit",
    "check:seo": "node scripts/verify-seo.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser.mjs",
    "optimize:assets": "node scripts/optimize-static-assets.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@supabase/supabase-js": "2.112.0",
    "dompurify": "3.4.13"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
