Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirecionamentos permanentes das URLs antigas. As queries são mantidas.
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/index\.html(?:[?\s]|$) [NC]
  RewriteRule ^index\.html$ /clientes/blogadvogado/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/areas-de-atuacao\.html(?:[?\s]|$) [NC]
  RewriteRule ^areas-de-atuacao\.html$ /clientes/blogadvogado/areas-de-atuacao/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/area-detalhe\.html(?:[?\s]|$) [NC]
  RewriteRule ^area-detalhe\.html$ /clientes/blogadvogado/area/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/direito-previdenciario\.html(?:[?\s]|$) [NC]
  RewriteRule ^direito-previdenciario\.html$ /clientes/blogadvogado/direito-previdenciario/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/direito-trabalhista\.html(?:[?\s]|$) [NC]
  RewriteRule ^direito-trabalhista\.html$ /clientes/blogadvogado/direito-trabalhista/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/direito-civil\.html(?:[?\s]|$) [NC]
  RewriteRule ^direito-civil\.html$ /clientes/blogadvogado/direito-civil/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/blog\.html(?:[?\s]|$) [NC]
  RewriteRule ^blog\.html$ /clientes/blogadvogado/blog/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/artigo\.html(?:[?\s]|$) [NC]
  RewriteRule ^artigo\.html$ /clientes/blogadvogado/artigo/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/contato\.html(?:[?\s]|$) [NC]
  RewriteRule ^contato\.html$ /clientes/blogadvogado/contato/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/politica-de-privacidade\.html(?:[?\s]|$) [NC]
  RewriteRule ^politica-de-privacidade\.html$ /clientes/blogadvogado/politica-de-privacidade/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/politica-de-cookies\.html(?:[?\s]|$) [NC]
  RewriteRule ^politica-de-cookies\.html$ /clientes/blogadvogado/politica-de-cookies/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/termos-de-uso\.html(?:[?\s]|$) [NC]
  RewriteRule ^termos-de-uso\.html$ /clientes/blogadvogado/termos-de-uso/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/admin/login\.html(?:[?\s]|$) [NC]
  RewriteRule ^admin/login\.html$ /clientes/blogadvogado/admin/login/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/admin/painel\.html(?:[?\s]|$) [NC]
  RewriteRule ^admin/painel\.html$ /clientes/blogadvogado/admin/ [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+clientes/blogadvogado/admin/editor\.html(?:[?\s]|$) [NC]
  RewriteRule ^admin/editor\.html$ /clientes/blogadvogado/admin/editor/ [R=301,L,NE]

  # Uma única forma pública por rota: sempre com barra final.
  RewriteRule ^(areas-de-atuacao|area|direito-previdenciario|direito-trabalhista|direito-civil|blog|artigo|contato|politica-de-privacidade|politica-de-cookies|termos-de-uso|admin|admin/login|admin/editor)$ /clientes/blogadvogado/$1/ [R=301,L,NE]
  RewriteRule ^blog/([^/]+)$ /clientes/blogadvogado/blog/$1/ [R=301,L,NE]
  RewriteRule ^areas-de-atuacao/([^/]+)$ /clientes/blogadvogado/areas-de-atuacao/$1/ [R=301,L,NE]

  # Aliases antigos de detalhes de área apontam para a rota canônica.
  RewriteRule ^areas-de-atuacao/direito-previdenciario/$ /clientes/blogadvogado/direito-previdenciario/ [R=301,L,NE]
  RewriteRule ^areas-de-atuacao/direito-trabalhista/$ /clientes/blogadvogado/direito-trabalhista/ [R=301,L,NE]
  RewriteRule ^areas-de-atuacao/direito-civil/$ /clientes/blogadvogado/direito-civil/ [R=301,L,NE]

  # Rewrites internos: a URL continua limpa durante acesso direto e atualização.
  RewriteRule ^$ index.html [L]
  RewriteRule ^areas-de-atuacao/$ areas-de-atuacao.html [L]
  RewriteRule ^area/$ area-detalhe.html [L]
  RewriteRule ^direito-previdenciario/$ direito-previdenciario.html [L]
  RewriteRule ^direito-trabalhista/$ direito-trabalhista.html [L]
  RewriteRule ^direito-civil/$ direito-civil.html [L]
  RewriteRule ^blog/$ blog.html [L]
  RewriteRule ^blog/[^/]+/$ artigo.html [L]
  RewriteRule ^artigo/$ artigo.html [L]
  RewriteRule ^contato/$ contato.html [L]
  RewriteRule ^politica-de-privacidade/$ politica-de-privacidade.html [L]
  RewriteRule ^politica-de-cookies/$ politica-de-cookies.html [L]
  RewriteRule ^termos-de-uso/$ termos-de-uso.html [L]
  RewriteRule ^admin/login/$ admin/login.html [L]
  RewriteRule ^admin/editor/$ admin/editor.html [L]
  RewriteRule ^admin/$ admin/painel.html [L]
  RewriteRule ^areas-de-atuacao/[^/]+/$ area-detalhe.html [L]
</IfModule>

DirectoryIndex index.html
ErrorDocument 404 /clientes/blogadvogado/404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://lh3.googleusercontent.com https://qlrdfwxvbxnysfgkikhf.supabase.co; connect-src 'self' https://qlrdfwxvbxnysfgkikhf.supabase.co wss://qlrdfwxvbxnysfgkikhf.supabase.co; frame-src https://www.youtube-nocookie.com https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  <FilesMatch "\.(?:css|js|woff2|webp|png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
